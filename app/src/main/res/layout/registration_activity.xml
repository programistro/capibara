<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="#d5e4ad"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:layout_gravity="center"
        android:orientation="vertical"
        android:background="@drawable/shape"
        android:layout_width="375dp"
        android:layout_height="450dp"
        android:layout_marginTop="130dp">
        <TextView
            android:textSize="30sp"
            android:textColor="#000000"
            android:layout_gravity="center"
            android:id="@+id/textView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Регистрация"/>
        <TextView
            android:textSize="25sp"
            android:textColor="#000000"
            android:id="@+id/textView2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="33dp"
            android:layout_marginTop="20dp"
            android:text="Пин-код"/>
        <EditText
            android:textColor="#000000"
            android:textColorHint="#6a6a6a"
            android:layout_gravity="center"
            android:id="@+id/user_password"
            android:background="#d9d9d9"
            android:layout_width="300dp"
            android:layout_height="50dp"
            android:layout_marginTop="20dp"
            android:hint="Введите пин-код"
            android:ems="10"
            android:inputType="numberPassword"/>
        <TextView
            android:textSize="25sp"
            android:textColor="#000000"
            android:id="@+id/textView4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="33dp"
            android:layout_marginTop="20dp"
            android:text="Повторите пин-код"/>
        <EditText
            android:textColor="#000000"
            android:textColorHint="#6a6a6a"
            android:layout_gravity="center"
            android:id="@+id/user_repeat_password"
            android:background="#d9d9d9"
            android:layout_width="300dp"
            android:layout_height="50dp"
            android:layout_marginTop="20dp"
            android:hint="Введите пин-код еще раз"
            android:ems="10"
            android:inputType="numberPassword"/>
        <Button
            android:textSize="15sp"
            android:textColor="#000000"
            android:layout_gravity="center"
            android:id="@+id/button_registration"
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Зарегестрироваться"
            android:backgroundTint="#a9d193"/>
    </LinearLayout>
</LinearLayout>

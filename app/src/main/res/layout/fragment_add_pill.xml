<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:padding="16dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:gravity="center"
            android:paddingBottom="24dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Напоминание"/>
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:paddingBottom="4dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Название"/>
        <EditText
            android:textColor="#6a6a6a"
            android:textColorHint="#6a6a6a"
            android:id="@+id/etPillName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Введите название"
            android:inputType="textCapWords"/>
        <LinearLayout
            android:orientation="horizontal"
            android:paddingTop="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp">
                <TextView
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#000000"
                    android:paddingBottom="4dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Дата начала"/>
                <EditText
                    android:textColor="#6a6a6a"
                    android:textColorHint="#6a6a6a"
                    android:id="@+id/etStartDate"
                    android:focusable="false"
                    android:clickable="true"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Выберите дату"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp">
                <TextView
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#000000"
                    android:paddingBottom="4dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Время приема"/>
                <EditText
                    android:textColor="#6a6a6a"
                    android:textColorHint="#6a6a6a"
                    android:id="@+id/etIntakeTime"
                    android:focusable="false"
                    android:clickable="true"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Выберите время"/>
            </LinearLayout>
        </LinearLayout>
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:paddingTop="16dp"
            android:paddingBottom="4dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Периодичность"/>
        <Spinner
            android:textColor="#6a6a6a"
            android:textColorHint="#6a6a6a"
            android:id="@+id/spinnerPeriodicity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <Switch
                android:textSize="16sp"
                android:textColor="#000000"
                android:id="@+id/switchReminder"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="Напоминание"/>
            <EditText
                android:textColor="#6a6a6a"
                android:textColorHint="#6a6a6a"
                android:id="@+id/etReminderTime"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:hint="Минуты до приема (по умолчанию 180)"
                android:layout_weight="1"
                android:inputType="number"
                android:layout_marginStart="16dp"/>
        </LinearLayout>
        <TextView
            android:textSize="12sp"
            android:textColor="#000000"
            android:paddingTop="4dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="* По умолчанию напоминание за 3 часа (180 минут)"/>
        <LinearLayout
            android:orientation="horizontal"
            android:paddingTop="32dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <Button
                android:textColor="#000000"
                android:id="@+id/btnCancel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Отмена"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:backgroundTint="#a9d193"/>
            <Button
                android:textColor="#000000"
                android:id="@+id/btnSave"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Сохранить"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:backgroundTint="#a9d193"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>

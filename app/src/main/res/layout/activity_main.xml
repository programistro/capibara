<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="#f8f8f8"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/shape_main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="275dp">
        <FrameLayout
            android:layout_gravity="center"
            android:orientation="vertical"
            android:id="@+id/fragment_frame"
            android:background="@drawable/shape"
            android:layout_width="350dp"
            android:layout_height="350dp"
            android:layout_marginTop="30dp"/>
        <LinearLayout
            android:layout_gravity="center"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ImageButton
                android:id="@+id/button"
                android:background="@drawable/rounded_button"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:layout_margin="10dp"
                android:src="@drawable/ic_game"
                android:scaleType="centerInside"
                android:backgroundTint="#a9d193"/>
            <ImageButton
                android:id="@+id/button2"
                android:background="@drawable/rounded_button"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:layout_margin="10dp"
                android:src="@drawable/ic_customize"
                android:scaleType="centerInside"
                android:backgroundTint="#a9d193"/>
            <ImageButton
                android:id="@+id/button3"
                android:background="@drawable/rounded_button"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:layout_margin="10dp"
                android:src="@drawable/ic_add"
                android:scaleType="centerInside"
                android:backgroundTint="#a9d193"/>
            <ImageButton
                android:id="@+id/button4"
                android:background="@drawable/rounded_button"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:layout_margin="10dp"
                android:src="@drawable/ic_list"
                android:scaleType="centerInside"
                android:backgroundTint="#a9d193"/>
        </LinearLayout>
    </LinearLayout>
    <ImageView
        android:id="@+id/background_forest"
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:scaleType="centerCrop"
        app:srcCompat="@drawable/background_forest"/>
    <FrameLayout
        android:id="@+id/walletContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="10dp">
        <ImageView
            android:id="@+id/walletImage"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:src="@drawable/wallet"
            android:scaleType="fitCenter"/>
        <TextView
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#ffffff"
            android:layout_gravity="center"
            android:id="@+id/tvCoinCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="15dp"
            android:text="50"
            android:shadowColor="#80000000"
            android:shadowDx="2"
            android:shadowDy="2"
            android:shadowRadius="3"/>
    </FrameLayout>
    <FrameLayout
        android:layout_gravity="center_horizontal"
        android:id="@+id/pet_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp">
        <ImageView
            android:layout_gravity="center_horizontal"
            android:id="@+id/pet_crying"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:layout_marginTop="50dp"
            app:srcCompat="@drawable/pet_crying"/>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/body_layer"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/hat_layer"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/glasses_layer"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/accessory1_layer"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/accessory2_layer"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </FrameLayout>
    <LinearLayout
        android:layout_gravity="top|right"
        android:orientation="vertical"
        android:background="@drawable/shape_mood"
        android:padding="12dp"
        android:layout_width="120dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginRight="10dp">
        <TextView
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:layout_gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="Настроение капибары"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp">
            <TextView
                android:textSize="11sp"
                android:textColor="#666666"
                android:id="@+id/todayProgressText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="2dp"
                android:text="Сегодня: 0/0"/>
            <ProgressBar
                android:id="@+id/todayProgressBar"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:max="100"
                android:progress="0"
                android:progressTint="#2196f3"
                android:backgroundTint="#e0e0e0"
                style="?android:attr/progressBarStyleHorizontal"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#ffc107"
                android:id="@+id/moodTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="В норме"/>
            <ProgressBar
                android:id="@+id/moodProgressBar"
                android:layout_width="match_parent"
                android:layout_height="10dp"
                android:max="100"
                android:progress="50"
                android:progressTint="#ffc107"
                android:backgroundTint="#e0e0e0"
                style="?android:attr/progressBarStyleHorizontal"/>
            <TextView
                android:textSize="10sp"
                android:textColor="#666666"
                android:layout_gravity="center_horizontal"
                android:id="@+id/moodScoreTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="50/100"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
